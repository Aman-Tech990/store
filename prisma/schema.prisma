generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
  role     Role   @default(USER)

  registeredAt DateTime @default(now())
  updatedAt    DateTime @default(now())
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  price       Int
  stock       Int     @default(0)
  image       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}
